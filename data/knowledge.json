{"dataVersion":"efc820e0ba96","concepts":[{"id":"kinematics-components","name":"運動の成分への分解","field":"MEC","requires":[],"laws":[]},{"id":"uniform-acceleration","name":"等加速度運動","field":"MEC","requires":["kinematics-components"],"laws":["uniform-acceleration-eq"]},{"id":"projectile-motion","name":"放物運動","field":"MEC","requires":["uniform-acceleration","kinematics-components"],"laws":["uniform-acceleration-eq"]},{"id":"force-concept","name":"力のはたらき","field":"MEC","requires":[],"laws":[]},{"id":"force-decomposition","name":"力の分解","field":"MEC","requires":["force-concept","kinematics-components"],"laws":[]},{"id":"equilibrium","name":"力のつり合い","field":"MEC","requires":["force-decomposition"],"laws":["newton-1st"]},{"id":"normal-force","name":"垂直抗力","field":"MEC","requires":["force-concept","equilibrium"],"laws":["newton-3rd"]},{"id":"static-friction","name":"静止摩擦力","field":"MEC","requires":["normal-force"],"laws":["friction-law"]},{"id":"equation-of-motion","name":"運動方程式の立て方","field":"MEC","requires":["force-decomposition"],"laws":["newton-2nd"]},{"id":"simple-harmonic-motion","name":"単振動","field":"MEC","requires":["equation-of-motion"],"laws":["hooke-law","shm-period"]},{"id":"series-parallel","name":"抵抗の直列・並列","field":"ELM","requires":["ohm-law-use"],"laws":["ohm-law","kirchhoff-1st","kirchhoff-2nd"]},{"id":"ohm-law-use","name":"オームの法則の使い方","field":"ELM","requires":[],"laws":["ohm-law"]},{"id":"current-conservation","name":"電流の保存（分岐点）","field":"ELM","requires":[],"laws":["kirchhoff-1st"]}],"laws":[{"id":"newton-1st","name":"慣性の法則","tex":"\\sum \\vec F=\\vec 0 \\iff \\vec v=\\text{一定}","conditions":"慣性系","concepts":["equilibrium"],"html":"$\\sum \\vec F=\\vec 0 \\iff \\vec v=\\text{一定}$"},{"id":"newton-2nd","name":"運動方程式","tex":"m\\vec a=\\vec F","conditions":"慣性系。質量が一定","concepts":["equation-of-motion"],"html":"$m\\vec a=\\vec F$"},{"id":"newton-3rd","name":"作用・反作用の法則","tex":"\\vec F_{\\mathrm{AB}}=-\\vec F_{\\mathrm{BA}}","conditions":"2物体間の力","concepts":["normal-force"],"html":"$\\vec F_{\\mathrm{AB}}=-\\vec F_{\\mathrm{BA}}$"},{"id":"uniform-acceleration-eq","name":"等加速度運動の式","tex":"v=v_0+at,\\quad x=v_0t+\\tfrac12at^2,\\quad v^2-v_0^2=2ax","conditions":"加速度が一定","concepts":["uniform-acceleration"],"html":"$v=v_0+at,\\quad x=v_0t+\\tfrac12at^2,\\quad v^2-v_0^2=2ax$"},{"id":"friction-law","name":"摩擦の法則","tex":"f\\le \\mu N,\\quad f'=\\mu' N","conditions":"静止摩擦は最大摩擦力まで。動摩擦力は速さによらない（近似）","concepts":["static-friction"],"html":"$f\\le \\mu N,\\quad f'=\\mu' N$"},{"id":"hooke-law","name":"フックの法則","tex":"F=-kx","conditions":"弾性限度内","concepts":["simple-harmonic-motion"],"html":"$F=-kx$"},{"id":"shm-period","name":"単振動の周期","tex":"T=2\\pi\\sqrt{\\frac{m}{k}}","conditions":"復元力が変位に比例（F=-kx）","concepts":["simple-harmonic-motion"],"html":"$T=2\\pi\\sqrt{\\frac{m}{k}}$"},{"id":"ohm-law","name":"オームの法則","tex":"V=RI","conditions":"抵抗値が一定（オーム抵抗）","concepts":["ohm-law-use"],"html":"$V=RI$"},{"id":"kirchhoff-1st","name":"キルヒホッフの第1法則","tex":"\\sum I_{\\text{入}}=\\sum I_{\\text{出}}","conditions":"定常電流","concepts":["current-conservation"],"html":"$\\sum I_{\\text{入}}=\\sum I_{\\text{出}}$"},{"id":"kirchhoff-2nd","name":"キルヒホッフの第2法則","tex":"\\sum V=\\sum RI","conditions":"閉回路を一周","concepts":["series-parallel"],"html":"$\\sum V=\\sum RI$"}],"misconceptions":[{"id":"MC-NORMAL-EQ-MG","wrong":"垂直抗力はいつも mg に等しい","right":"垂直抗力は面に垂直な方向の力のつり合い（または運動方程式）で決まる。斜面上では mg cos θ","concepts":["normal-force"],"remedy":["MEC-CON-001","MEC-INC-001"]},{"id":"MC-FRICTION-MAX","wrong":"静止摩擦力はいつも μN に等しい","right":"静止摩擦力の大きさはつり合いで決まり、μN はその上限（最大摩擦力）","concepts":["static-friction"],"remedy":["MEC-CON-001"]},{"id":"MC-SHM-PERIOD-AMPLITUDE","wrong":"大きく振らせるほど単振動の周期は長くなる","right":"ばね振り子の周期 2π√(m/k) は振幅によらない","concepts":["simple-harmonic-motion"],"remedy":["MEC-SHM-001"]},{"id":"MC-SHM-PERIOD-LINEAR-M","wrong":"質量を2倍にすると周期も2倍になる","right":"周期は √m に比例するので √2 倍","concepts":["simple-harmonic-motion"],"remedy":["MEC-SHM-001"]},{"id":"MC-PROJ-VX-CHANGES","wrong":"放物運動で水平方向の速さもだんだん小さくなる",