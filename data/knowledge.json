,"max":5,"step":0.1,"default":1},"theta0":{"label":"振れ角","unit":"deg","min":1,"max":170,"step":1,"default":10},"g":{"label":"重力加速度","unit":"m/s^2","min":1,"max":20,"step":0.1,"default":9.8}},"observables":{"theta":"rad","omega":"rad/s"},"measures":{"period":"s"},"plots":[["t","theta"],["t","omega"]]},{"id":"mech.collision","name":"1次元の衝突","field":"MEC","model":"mechanics/collision","status":"planned","params":{"m1":{"label":"質量 m1","unit":"kg","min":0.1,"max":10,"step":0.1,"default":1},"m2":{"label":"質量 m2","unit":"kg","min":0.1,"max":10,"step":0.1,"default":1},"v1":{"label":"速度 v1","unit":"m/s","min":-10,"max":10,"step":0.1,"default":3},"v2":{"label":"速度 v2","unit":"m/s","min":-10,"max":10,"step":0.1,"default":0},"e":{"label":"反発係数","unit":"1","min":0,"max":1,"step":0.01,"default":1}},"observables":{"x1":"m","x2":"m","p":"kg*m/s","K":"J"},"plots":[["t","x1"],["t","p"],["t","K"]]},{"id":"mech.circular","name":"等速円運動","field":"MEC","model":"mechanics/circular","status":"planned","params":{"r":{"label":"半径","unit":"m","min":0.1,"max":10,"step":0.1,"default":2},"v":{"label":"速さ","unit":"m/s","min":0.1,"max":20,"step":0.1,"default":4}},"observables":{"x":"m","y":"m","ax":"m/s^2","ay":"m/s^2"},"plots":[["t","x"],["t","y"]]},{"id":"mech.gravitation","name":"万有引力と軌道","field":"MEC","model":"mechanics/gravitation","status":"planned","params":{"r0":{"label":"初期距離（地球半径の何倍）","unit":"1","min":1.1,"max":10,"step":0.1,"default":2},"vratio":{"label":"初速（円軌道の速さの何倍）","unit":"1","min":0,"max":1.6,"step":0.01,"default":1}},"observables":{"x":"m","y":"m","E":"J","L":"kg*m^2/s"},"plots":[["t","E"],["t","L"]]}]}