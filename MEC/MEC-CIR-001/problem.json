 "examStyle": "original",
 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "なめらかな水平面上で，長さ $r$ の軽い糸の一端を点 O に固定し，他端につけた質量 $m$ の小球を，速さ $v$ で O のまわりに等速円運動させた．図は真上から見たものである．"
   },
   {
    "type": "figure",
    "ref": "q-setup"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "小球の角速度 $\\omega$ を求めよ．"
     },
     {
      "id": "2",
      "tex": "円運動の周期 $T$ を求めよ．"
     },
     {
      "id": "3",
      "tex": "糸が小球を引く力の大きさ $S$ を求めよ．"
     }
    ]
   }
  ]
 },
 "figures": [
  {
   "id": "q-setup",
   "role": "question",
