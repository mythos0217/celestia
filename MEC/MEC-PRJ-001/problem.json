 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "水平な地面上の点 O から，小球を水平と角 $\\theta$ をなす向きに速さ $v_0$ で投げ上げた．重力加速度の大きさを $g$ とし，空気抵抗は無視する．"
   },
   {
    "type": "figure",
    "ref": "q-setup"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "投げてから最高点に達するまでの時間 $t_1$ を求めよ．"
     },
     {
      "id": "2",
      "tex": "最高点の高さ $H$ を求めよ．"
     },
     {
      "id": "3",
      "tex": "点 O から落下点までの水平距離 $R$ を求めよ．"
     }
    ]
   }
  ]
 },
