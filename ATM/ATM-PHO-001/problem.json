{
 "id": "ATM-PHO-001",
 "schema": "celestia.problem/1",
 "field": "ATM",
 "unit": "ATM-01",
 "topic": "光電効果の式",
 "course": "物理",
 "level": 1,
 "minutes": 8,
 "format": [
  "derivation",
