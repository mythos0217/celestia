 "examStyle": "common-test",
 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "半減期 $T$ の放射性原子核が，はじめ $N_0$ 個ある．"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "時間 $3T$ 後に残っている原子核の数を求めよ．"
     },
     {
      "id": "2",
      "tex": "残っている数が $\\dfrac{N_0}{16}$ になるのは何時間後か．"
     },
     {
      "id": "3",
      "tex": "時間 $2T$ の間に崩壊した原子核の数を求めよ．"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "$\\dfrac{N_0}8$",
    "grading": "N_0/8"
   },
   {
    "id": "2",
    "tex": "$4T$",
    "grading": "4T"
   },
   {
    "id": "3",
    "tex": "$\\dfrac34N_0$",
    "grading": "3N_0/4"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "(1) $N=N_0\\left(\\dfrac12\\right)^3=\\dfrac{N_0}8$．\n\n(2) $\\left(\\dfrac12\\right)^k=\\dfrac1{16}$ より $k=4$：$4T$ 後．\n\n(3) $2T$ 後に残るのは $\\dfrac{N_0}4$．崩壊したのは $N_0-\\dfrac{N_0}4=\\dfrac34N_0$．$2T$ で全部なくなるわけではない．"
    }
   ]
  }
 ],
 "idea": {
  "tex": "半減期ごとに半分．$t$ 後は $\\left(\\dfrac12\\right)^{t/T}$ 倍．"
 },
