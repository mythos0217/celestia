 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "$T=\\dfrac{Mg}{2\\sin\\theta}$",
    "grading": "T：M g/(2sin(θ))"
   },
   {
    "id": "2",
    "tex": "$H=\\dfrac{Mg}{2\\tan\\theta}$",
    "grading": "H：M g/(2tan(θ))"
