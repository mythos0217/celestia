 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "なめらかな水平面上で，ばね定数 $k$ の軽いばねの一端を壁に固定し，他端に質量 $m$ の物体をつける．物体を自然長の位置から $A$ だけ引いて静かに放した．"
   },
   {
    "type": "figure",
    "ref": "q-setup"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "物体の単振動の周期 $T$ を求めよ．"
     },
     {
      "id": "2",
      "tex": "物体の速さの最大値 $v_{\\mathrm{max}}$ を求めよ．"
     },
     {
      "id": "3",
      "tex": "物体の質量を $2m$ に変えて同じように振動させると，周期は何倍になるか．"
     }
    ]
   }
  ]
 },
 "figures": [
  {
   "id": "q-setup",
   "role": "question",
