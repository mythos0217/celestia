{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "celestia.laws/1",
 "type": "object",
 "required": [
  "schema",
  "laws"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "celestia.laws/1"
  },
  "laws": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "tex",
     "conditions",
     "concepts"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "name": {
      "type": "string"
     },
     "tex": {
      "type": "string"
     },
     "conditions": {
      "type": "string"
     },
     "concepts": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
     }
    }
   }
  }
 }
}