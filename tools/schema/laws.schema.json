{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "celestia.laws/1",
 "type": "object",
 "required": [
  "schema",
  "laws"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "celestia.laws/1"
  },
  "laws": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "tex",
     "conditions",
     "concepts",
     "origin"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "name": {
      "type": "string"
     },
     "tex": {
      "type": "string"
     },
     "conditions": {
      "type": "string"
     },
     "concepts": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
     },
     "origin": {
      "enum": [
       "fundamental",
       "empirical",
       "derived",
       "definition"
      ],
      "description": "fundamental=出発点となる法則、empirical=実験から得た法則、derived=ほかの法則から導く、definition=定義"
     },
     "basis": {
      "type": "string",
      "description": "導出しない法則の根拠・由来（TeX）"
     },
     "derivation": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "tex"
       ],
       "additionalProperties": false,
       "properties": {
        "tex": {
         "type": "string"
        },
        "figure": {
         "type": "string"
        }
       }
      }
     },
     "simulations": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z]+\\.[a-z0-9-]+$"
      }
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "origin": {
         "const": "derived"
        }
       }
      },
      "then": {
       "required": [
        "derivation"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "origin": {
         "enum": [
          "fundamental",
          "empirical"
         ]
        }
       }
      },
      "then": {
       "required": [
        "basis"
       ]
      }
     }
    ]
   }
  }
 }
}