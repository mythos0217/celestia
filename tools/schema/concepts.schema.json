{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "celestia.concepts/1",
 "type": "object",
 "required": [
  "schema",
  "concepts"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "celestia.concepts/1"
  },
  "concepts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "field",
     "requires",
     "laws"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "name": {
      "type": "string"
     },
     "field": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
     },
     "requires": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
     },
     "laws": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 }
}