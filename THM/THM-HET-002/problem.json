 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "消費電力 $420\\,\\mathrm W$ の電熱線で，質量 $1.0\\,\\mathrm{kg}$ の水を $100$ 秒間加熱した．水の比熱を $4.2\\times10^3\\,\\mathrm{J/(kg\\cdot K)}$ とする．"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "電熱線で発生した熱量を求めよ．"
     },
     {
      "id": "2",
      "tex": "発生した熱がすべて水に与えられたとき，水の温度上昇を求めよ．"
     },
     {
      "id": "3",
      "tex": "発生した熱の $20\\%$ が周囲に逃げたとき，水の温度上昇を求めよ．"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "$4.2\\times10^4\\,\\mathrm J$",
    "grading": "42000 [J]"
   },
   {
    "id": "2",
    "tex": "$10\\,\\mathrm K$",
    "grading": "10 [K]"
   },
