 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "焦点距離 $1.0\\,\\mathrm m$ の凸レンズの前方に物体を置く．"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "物体をレンズの前方 $1.5\\,\\mathrm m$ に置いた．像はレンズの後方何 m にできるか．"
     },
     {
      "id": "2",
      "tex": "(1) の像の倍率を求めよ．"
     },
     {
      "id": "3",
      "tex": "物体をレンズの前方 $0.50\\,\\mathrm m$ に置くと，虚像ができる．虚像はレンズの前方何 m にできるか．"
     },
     {
      "id": "4",
      "tex": "(3) の像の倍率を求めよ．"
     }
    ]
   }
  ]
 },
 "figures": [],
